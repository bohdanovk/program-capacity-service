# Copy to .env for local development. Production must set every value explicitly.

NODE_ENV=development
PORT=3000

# API keys: name:secret:scope[+scope], comma separated.
# Secrets must be at least 16 characters of [A-Za-z0-9._~-]. Scopes: read, write.
API_KEYS=local-admin:local-admin-key-0123456789:read+write,local-reader:local-reader-key-0123456789:read

# Static FX rates as BASE/QUOTE=rate (up to 10 decimals). Only listed pairs are served;
# inverse and cross rates are never derived.
FX_RATES=EUR/USD=1.0850,GBP/USD=1.2700,USD/EUR=0.9217,JPY/USD=0.0066889632

# Treasury feed (topic treasury.program-capacity.v1). Set KAFKA_ENABLED=false to run the API alone.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=program-capacity-service
KAFKA_GROUP_ID=program-capacity-service

# OpenAPI UI and JSON at /docs (public, read-only).
SWAGGER_ENABLED=true
